{
  "name": "git-club-event-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Git Club Event Hub - Fullstack Application with Express, SQLite, and React",
  "scripts": {
    "start": "concurrently --kill-others-on-fail -n \"backend,frontend\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "dev": "concurrently --kill-others-on-fail -n \"backend,frontend\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && npm start",
    "frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "install:all": "cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
